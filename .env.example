# Copie para .env (que fica fora do git) e preencha.
PORT=3000
# ID de cliente OAuth do Google (Google Cloud Console > Credenciais). Origem autorizada: http://localhost:3000
GOOGLE_CLIENT_ID=
# Segredo que assina o cookie de sessão. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=8
# Domínios institucionais aceitos (aceita subdomínios, ex.: aluno.institutoponte.org.br)
ALLOWED_EMAIL_DOMAINS=institutoponte.org.br
# E-mails extras autorizados, separados por vírgula (opcional)
ALLOWED_EMAILS=
# Nome completo dos medalhistas na lista (LGPD, specs.md 7). Padrão false: só iniciais + código.
ALUNO_IDENTIFICADO=false
